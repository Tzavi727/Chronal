<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:TimeSentinel.ViewModels"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
			 Width="500"
			 Height="450"
             Background="{DynamicResource WindowBgBrush}"
             x:Class="TimeSentinel.Views.HomeView"
             x:DataType="viewmodels:HomeViewModel">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0"
                Padding="15"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderMainBrush}">
            <ComboBox ItemsSource="{Binding ProcessList}"
                      SelectedItem="{Binding SelectedProcess}"
                      Opacity="{Binding DetailsOpacity}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ProcessName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Border>
        <TextBlock Grid.Row="0"
                   Text="Process Selection"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Background="{DynamicResource WindowBgBrush}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="10,-8,0,0"/>


        <Border Grid.Row="1"
                Margin="0,15,0,0"
                Padding="15"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderMainBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0"  HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="LIFETIME_UPTIME:" FontSize="16"/>
                    <TextBlock Text="{Binding DisplayLifeTime}" FontSize="16" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1"  HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="CURRENT_SESSION:" FontSize="16"/>
                    <TextBlock Text="{Binding DisplaySession}" FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0"  HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="PROCESS_STATUS:" FontSize="16"/>
                    <TextBlock Text="{Binding DisplayStatus}"  FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1"  HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="LAST_SESSION:" FontSize="16"/>
                    <TextBlock Text="{Binding DisplayLastSession}" FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>



        </Border>
        <TextBlock Grid.Row="1"
                   Text="Process Details"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Background="{DynamicResource WindowBgBrush}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="10,8,0,0"/>
    </Grid>
</UserControl>
