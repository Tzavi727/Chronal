<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="using:TimeSentinel.Views"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:viewmodels="using:TimeSentinel.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
			 Background="{DynamicResource WindowBgBrush}"
			 Width="500"
			 Height="450"
			 x:Class="TimeSentinel.Views.SettingsView"
			 x:DataType="viewmodels:SettingsViewModel">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>


		<ListBox Grid.Row="0"
				 ItemsSource="{Binding RegisteredProcesses}"
				 Margin="10"
				 BorderBrush="{DynamicResource BorderMainBrush}"
				 BorderThickness="1"
				 Background="{DynamicResource WindowBgBrush}"
				 SelectedItem="{Binding SelectedProcess}">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Grid ColumnDefinitions="Auto, *, *">
					<CheckBox Grid.Column="0"
							  IsChecked="{Binding IsActive}"
							  Margin="0,0,10,0"/>
						<TextBlock Grid.Column="1" Text="{Binding ProcessName}" HorizontalAlignment="Left"/>
						<TextBlock Grid.Column="2" Text="{Binding ProcessTotalTime}" HorizontalAlignment="Right"/>
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>

		</ListBox>
		<TextBlock Grid.Row="0"
				   Text="Registered Processes"
				   FontWeight="SemiBold"
				   FontSize="12"
				   Background="{DynamicResource WindowBgBrush}"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Top"
				   Margin="18,3,0,0"/>


		<Border Grid.Row="2"
				Margin="10"
				Padding="15"
				BorderThickness="1"
				BorderBrush="{DynamicResource BorderMainBrush}">

			<StackPanel Spacing="10">
				<Grid ColumnDefinitions="*,auto,*">
					<Grid Grid.Column="0">
						<TextBox Grid.Column="0"
								 PlaceholderText="Process Name."
								 Text="{Binding ProcessNameToAdd}"
								 Margin="5"
								 HorizontalAlignment="Stretch">
						</TextBox>
					</Grid>
					<Rectangle Grid.Column="1"
							   Width="1"
							   Fill="{DynamicResource BorderMainBrush}"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Stretch"
							   Margin="15, -15">
					</Rectangle>
					<TextBox Grid.Column="2"
							 PlaceholderText="Process to Delete."
							 Text="{Binding ProcessNameToRemove}"
							 Margin="5"
							 HorizontalAlignment="Stretch">
					</TextBox>
				</Grid>
				<Grid ColumnDefinitions="*,auto,*">
					<Button Grid.Column="0"
							Content="Register Process"
							FontSize="15"
							Height="50"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							Margin="5"
							Command="{Binding AddProcessCommand}">
					</Button>
					<Rectangle Grid.Column="1"
							   Width="1"
							   Fill="{DynamicResource BorderMainBrush}"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Stretch"
							   Margin="15,-15">
					</Rectangle>
					<Button Grid.Column="2"
							Content="Remove Process"
							FontSize="15"
							Height="50"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							Margin="5"
							Command="{Binding RemoveProcessCommand}">
					</Button>
				</Grid>
			</StackPanel>
		</Border>
		<TextBlock Grid.Row="2"
				   Text="Process Management"
				   FontWeight="SemiBold"
				   FontSize="12"
				   Background="{DynamicResource WindowBgBrush}"
				   Margin="20, 3, 0, 0"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Top"/>
	</Grid>
</UserControl>
